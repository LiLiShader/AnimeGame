  chapters:
  - name: "\u827E\u5C14\u5E9F\u589F"
    english: AEIR RUINS
    background: background_ruins
    description: "\u66FE\u7ECF\u7E41\u8363\u7684\u5929\u7A7A\u90FD\u5E02\uFF0C\u5982\u4ECA\u53EA\u5269\u6B8B\u57A3\u3002\n\u5728\u7834\u788E\u7684\u5149\u5F71\u4E2D\uFF0C\u4ECD\u6709\u672A\u77E5\u7684\u529B\u91CF\u82CF\u9192\u3002"
  - name: "\u5E7D\u5F71\u68EE\u6797"
    english: SHADOW FOREST
    background: background_forest
    description: "\u6811\u5F71\u6DF1\u5904\u56DE\u8361\u7740\u53E4\u8001\u7684\u4F4E\u8BED\uFF0C\n\u8DDF\u968F\u5FAE\u5149\uFF0C\u5BFB\u627E\u88AB\u9057\u5FD8\u7684\u5951\u7EA6\u3002"
  - name: "\u971C\u8BED\u51B0\u539F"
    english: FROSTLAND
    background: background_frost
    description: "\u88AB\u6C38\u6052\u51B0\u96EA\u8986\u76D6\u7684\u5723\u5802\uFF0C\n\u6B63\u7B49\u5F85\u4E00\u9897\u8DB3\u4EE5\u878D\u5316\u5BD2\u51AC\u7684\u5FC3\u3002"
  - name: "\u707C\u70ED\u8352\u6F20"
    english: BURNING DESERT
    background: background_desert
    description: "\u70C8\u7130\u541E\u6CA1\u4E86\u6614\u65E5\u7684\u738B\u57CE\uFF0C\n\u7070\u70EC\u4E4B\u4E0B\uFF0C\u4E0D\u5C48\u7684\u610F\u5FD7\u4ECD\u5728\u71C3\u70E7\u3002"
  - name: "\u865A\u7A7A\u4E4B\u57CE"
    english: VOID CITY
    background: background_void
    description: "\u8DE8\u8D8A\u7834\u788E\u7684\u65F6\u7A7A\u8FB9\u754C\uFF0C\n\u661F\u6D77\u5C3D\u5934\uFF0C\u547D\u8FD0\u5C06\u8FCE\u6765\u6700\u540E\u7684\u6289\u62E9\u3002"
